# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

./.idea
./.idea/*
.idea
package-lock.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated by scripts/gen-modules.mjs (Phase 3 build-time module codegen).
# The `*` matches the [lang] segment (escaping brackets in .gitignore is unreliable).
# The (app) session gate itself, generated from core/routes-app/:
/src/app/*/(app)/layout.js
/src/app/*/(app)/loading.js
# Gated route-group shims (under the (app) session gate):
/src/app/*/(app)/(core)/
/src/app/*/(app)/(leisure)/
/src/app/*/(app)/(citizen-engagement)/
/src/app/*/(app)/(mobility)/
# Public (ungated) core shims emitted at the [lang] root from routes-public/:
/src/app/*/page.js
/src/app/*/register/
/src/app/*/help/
# The [lang] layout/loading themselves, emitted from routes-public/:
/src/app/*/layout.js
/src/app/*/loading.js
# The true root app shell, emitted above [lang] from routes-root/
# (only the favicons remain hand-written in src/app/):
/src/app/layout.js
/src/app/not-found.js
/src/app/robots.js
/src/app/sitemap.js
# The Proxy/Middleware shim, emitted beside app/ from routes-src/:
/src/proxy.js
/src/lib/composition/registerModules.js
# The Tailwind source manifest (core stylesheet import + per-module @source):
/src/styles/modules.css

# Derived from the reference app by create-model-city-app/sync-template.mjs
# (regenerated on prepack):
/create-model-city-app/template/synced/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/docs/*
/docs
tsconfig.json

settings.json
{
  "name": "model-city-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "create-model-city-app"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen:modules": "modelcity gen",
    "release": "node scripts/release.mjs",
    "prebuild": "npm run gen:modules",
    "predev": "npm run gen:modules",
    "lint": "eslint",
    "dep:check": "npm run gen:modules && depcruise src packages --config .dependency-cruiser.cjs",
    "a11y:lint": "eslint --rule 'jsx-a11y/*: error' src"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.20.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4"
  }
}

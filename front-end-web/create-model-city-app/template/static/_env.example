# Copy to .env.local and fill in the values. Never commit real secrets.

# ── Auth0 (Universal Login) ─────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# ── Back-end gateway ────────────────────────────────────────────────────────
MICROSERVICE_BASE_URL=https://localhost:8443
MICROSERVICE_USERS_APP_NAME=users
# Browser-side base URL for the mTLS certificate-verification flow (ALB).
NEXT_PUBLIC_MICROSERVICE_ALB_URL=https://localhost:8443

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ── AI translation (optional) ───────────────────────────────────────────────
GEMINI_API_KEY=

# ── Feature-module toggles (build time; exactly "false" disables) ───────────
MODULE_LEISURE=true
MODULE_ENGAGEMENT=true
MODULE_MOBILITY=true
